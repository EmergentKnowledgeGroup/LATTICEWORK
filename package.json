{
  "name": "latticework",
  "version": "0.0.0",
  "private": true,
  "description": "LATTICEWORK bounded candidate workspace; legacy runtime remains authoritative.",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/phase2"
  ],
  "scripts": {
    "p2:typecheck": "npm run typecheck --workspaces --if-present",
    "p2:test": "npm run test --workspace @latticework/kernel",
    "p2:build": "npm run build --workspace @latticework/web",
    "p2:preview": "npm run preview --workspace @latticework/web",
    "p2:browser": "npm run test --workspace @latticework/phase2-browser",
    "p2:verify-build": "node tools/reengineering/verify-phase2-build.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
